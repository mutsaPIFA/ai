# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git에 올라가지 않는다.
#   cp .env.example .env

# Gemini API 키 — AI Studio(aistudio.google.com)에서 발급.
# 태깅(/vision/tag)은 무료 티어로 동작, 이미지 생성(/vision/standardize)은 billing 필요(무료 할당 0).
GEMINI_API_KEY=

# 태깅 모델 (무료 티어 가능 — Flash-Lite 실험은 여기만 교체)
GEMINI_TAG_MODEL=gemini-2.5-flash

# 이미지 생성 모델 (기본값 유지, 신형 나오면 여기만 교체)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
